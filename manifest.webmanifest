{
  "name": "Arc9 Lite — découpe et annotation vidéo",
  "short_name": "Arc9 Lite",
  "description": "Couper des séquences, dessiner, commenter et partager en MP4, sans installation.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0e1014",
  "theme_color": "#0e1014",
  "lang": "fr",
  "icons": [
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "video/*": [".mp4", ".mov", ".m4v", ".webm"] } }
  ]
}
